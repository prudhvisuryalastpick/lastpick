# Web app build settings (copy to .env.production.local or set in the deploy workflow).
# VITE_APP_VARIANT is set by the build scripts: customer | owner | admin.

# Public addresses of the customer and partner sites.
VITE_CUSTOMER_URL=
VITE_PARTNER_URL=
# Leave empty on the web (same server). The Android apps set this to their server's https address.
VITE_API_URL=
# 1 = run in the browser with sample data only (no server)
VITE_DEMO=
# 1 = show one-time-code login (needs SMS/e-mail set up on the server; comes later)
VITE_OTP_LOGIN=

# Legal details shown in Contact, Privacy notice and Terms (required before launch:
# Consumer Protection (E-Commerce) Rules 2020, IT Rules 2021, DPDP Act 2023).
VITE_LEGAL_NAME=
VITE_LEGAL_ADDRESS=
VITE_GRIEVANCE_OFFICER=
VITE_GRIEVANCE_EMAIL=
VITE_GRIEVANCE_PHONE=
