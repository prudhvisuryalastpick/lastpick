{
  "name": "lastpick-web",
  "private": true,
  "version": "1.0.0",
  "description": "LastPick web apps: customer, partner (business) and admin builds from one codebase.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:customer": "VITE_APP_VARIANT=customer vite build --outDir dist-customer",
    "build:partner": "VITE_APP_VARIANT=owner vite build --outDir dist-partner",
    "build:admin": "VITE_APP_VARIANT=admin vite build --outDir dist-admin",
    "build:all": "npm run build:customer && npm run build:partner && npm run build:admin",
    "preview": "vite preview"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.8"
  }
}
